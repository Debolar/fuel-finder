# Copy to .env and fill in real values. Never commit .env.
APP_ENV=local
APP_VERSION=dev
# Leave empty to use the in-memory store.
# In Docker Compose, the host is the database service name (e.g. "db").
DATABASE_URL=postgresql://fuel:change-me@localhost:5432/fuel

# Used by the postgres container
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fuel
